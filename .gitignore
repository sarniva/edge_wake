# Build output (regenerate with: idf.py set-target esp32s3 && idf.py build)
build/
# Component-manager downloads (recreated by build; main/idf_component.yml pins them)
managed_components/
# Full config snapshot (regenerated from sdkconfig.defaults)
sdkconfig
sdkconfig.old
# EIM local environment paths (machine-specific)
eim_config.toml
# IDF toolchain caches
.cache/
# Editor / IDE files
.zed/
.clangd
# Python bytecode
__pycache__/
scripts/__pycache__/
# Local WiFi credentials (see main/wifi_config.example.h) - NEVER commit
main/wifi_config.h
